# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Push (FCM) — Firebase 서비스 계정 JSON을 base64로 인코딩한 값 (또는 raw JSON)
# 생성: Firebase Console → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성
#       base64 -i service-account.json | pbcopy
FIREBASE_SERVICE_ACCOUNT=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii...

# Cron
CRON_SECRET=your-cron-secret-here

# Season boundaries (optional override)
SEASON_SPRING_START=03-01
SEASON_SUMMER_START=06-01
SEASON_AUTUMN_START=09-01
SEASON_WINTER_START=12-01

# Email (Phase 2)
# RESEND_API_KEY=re_xxx
